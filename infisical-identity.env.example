# Copy to ~/.config/agentdeez/infisical-identity.env and chmod 600. Fill in after creating the
# machine identity in the local Infisical UI. Never commit the filled-in copy.
INFISICAL_API_URL=http://localhost:8080
INFISICAL_PROJECT_ID=REPLACE_ME_project_id
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=REPLACE_ME_client_id
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=REPLACE_ME_client_secret
# Set to 1 to also read/write plaintext token files in /tmp and the profile dir.
AGENTDEEZ_TOKEN_FILES=0
